HYOJO_RECORDING_PROVIDER=livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
# Configure a bucket lifecycle rule with this same number of days for video objects.
HYOJO_TRANSCRIPT_INGEST_KEY=
DATABASE_URL=postgres://hyojo:hyojo@localhost:5432/hyojo

# Production authentication. The default local mode accepts x-hyojo-actor for development only.
HYOJO_AUTH_MODE=production
HYOJO_JWT_SECRET=
HYOJO_JWT_ISSUER=
HYOJO_JWT_AUDIENCE=

# Admin web (development only)
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_HYOJO_DEV_ACTOR=toru

# Optional server-side AI narration. Disabled unless explicitly set to openai.
HYOJO_NARRATION_PROVIDER=mock
HYOJO_MEMORY_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Set this in apps/mobile/.env for a device-reachable API address.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
